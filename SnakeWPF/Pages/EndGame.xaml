<Page x:Class="SnakeWPF.Pages.EndGame"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:SnakeWPF.Pages"
      mc:Ignorable="d"
      d:DesignHeight="450"
      d:DesignWidth="800"
      Title="EndGame">

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/SnakeWPF;component/Image/background.jpeg"/>
        </Grid.Background>

        <Grid>
            <Grid Width="420"
                  Height="300"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">

                <Grid.Background>
                    <ImageBrush ImageSource="/SnakeWPF;component/Image/background2.png"
                                Stretch="Fill"/>
                </Grid.Background>

                <Label
                    x:Name="name"
                    Content="Alexashchka"
                    Margin="85,75,85,0"
                    VerticalAlignment="Top"
                    HorizontalContentAlignment="Center"
                    Foreground="#59351D"
                    FontFamily="Gabriola"
                    FontSize="22"/>

                <Label
                    x:Name="glasses"
                    Content="90 glasses"
                    Margin="85,110,85,0"
                    VerticalAlignment="Top"
                    HorizontalContentAlignment="Center"
                    Foreground="#59351D"
                    FontFamily="Gabriola"
                    FontSize="20"/>

                <Label
                    x:Name="top"
                    Content="999"
                    Margin="85,135,85,0"
                    Height="75"
                    VerticalAlignment="Top"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Foreground="#59351D"
                    FontFamily="Gabriola"
                    FontSize="48"/>

                <Button Click="OpenHome"
                        Content="Main Menu"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,45"
                        Width="180"
                        Height="30"
                        FontFamily="Gabriola"
                        FontSize="18"/>

            </Grid>
        </Grid>
    </Grid>
</Page>